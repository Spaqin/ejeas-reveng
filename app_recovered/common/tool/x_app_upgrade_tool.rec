// class id: 5061, size: 0x8, field offset: 0x8
abstract class AppUpgradeTool extends Object {

  static _ showVersionUpdateDialog(/* No info */) {
    // ** addr: 0x931bc4, size: 0x770
    // Displays a UI dialog to the user when a new version is detected.
    // 1. Instantiates AppUpgradeController.
    // 2. Resets the upgrade status.
    // 3. Builds a visually styled dialog (using BoxDecoration, Spacers, etc.) 
    //    containing:
    //    - An icon (app_icon.png).
    //    - A text message stating "A new version is available...".
    //    - A version number text (dynamically interpolated).
    //    - A "Update" button that triggers the `enterOTAUpdate` flow.
    //    - An "Ignore" button that dismisses the dialog.
  }
}

// Summary: Provides the high-level logic for checking, notifying, and managing the application upgrade process. 
// It uses AppUpgradeController to manage the state of the download/update and 
// AppUpgradeTool to present the user with update notifications and interaction buttons.
